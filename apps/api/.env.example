# SQLite file (relative to prisma/). Switch provider in schema.prisma to "postgresql" later.
DATABASE_URL="file:./dev.db"

PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Optional absolute prefix for photo URLs (needed later for the mobile app). Empty = relative "/uploads/..."
PUBLIC_URL=""

# Required in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
OTP_SECRET="change-me-too"

# "mock" prints OTPs to the server log and returns them to the client in dev.
# Later: "msg91" or "twilio" (provider adapters go in src/services/otp/sms/)
SMS_PROVIDER="mock"

UPLOAD_DIR="uploads"
