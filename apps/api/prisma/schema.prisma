// SKIB data model - Phase 1 (auth + onboarding) & Phase 2 (plans + host + group chat)
// SQLite for dev; change provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  phone        String         @unique // E.164, e.g. +919876543210
  name         String?
  birthDate    DateTime?
  gender       String? // woman | man | nonbinary (validated in app layer)
  bio          String?
  cityId       String?
  city         City?          @relation(fields: [cityId], references: [id])
  interests    UserInterest[]
  photos       Photo[]
  hostedPlans  Plan[]         @relation("PlanHost")
  planMembers  PlanMember[]
  planMessages PlanMessage[]
  onboardedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// One row per OTP sent. Codes are stored as HMAC hashes, never plain text.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model City {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  state    String
  isActive Boolean @default(true)
  users    User[]
  plans    Plan[]
}

model Interest {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  category String
  users    UserInterest[]
  plans    Plan[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  key       String // storage key (file name for local disk, object key for S3 later)
  position  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Phase 2: Plans, Host approval workflow, and Plan Group Chat
model Plan {
  id          String        @id @default(cuid())
  hostId      String
  cityId      String
  interestId  String
  title       String
  description String?
  venue       String
  startsAt    DateTime
  capacity    Int           @default(6) // includes the host
  status      String        @default("OPEN") // OPEN | CANCELLED
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  host        User          @relation("PlanHost", fields: [hostId], references: [id], onDelete: Cascade)
  city        City          @relation(fields: [cityId], references: [id])
  interest    Interest      @relation(fields: [interestId], references: [id])
  members     PlanMember[]
  messages    PlanMessage[]

  @@index([cityId, startsAt])
  @@index([hostId])
}

model PlanMember {
  id        String   @id @default(cuid())
  planId    String
  userId    String
  role      String   @default("ATTENDEE") // HOST | ATTENDEE
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  note      String? // optional intro message when requesting to join
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId, status])
}

model PlanMessage {
  id        String   @id @default(cuid())
  planId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}
